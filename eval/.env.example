# Copy to .env and fill in values before running the harness.

# Required for grounding check (layer 2).
# Same value as the backend's DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Required for LLM judge (layer 3).
# Same key as the backend's OPENAI_API_KEY (used for embeddings).
OPENAI_API_KEY=sk-...
