# Copy to .env and fill in values
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
# Replace [YOUR-PASSWORD] with your actual DB password
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
