# Copy to .env and fill in values

# Supabase — Transaction pooler, port 6543, +asyncpg for async driver
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Sync URL used by .helpers/build_embeddings.py (same as above, no +asyncpg)
DATABASE_URL_SYNC=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Groq — LLM generation (free) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenAI — embeddings only — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
